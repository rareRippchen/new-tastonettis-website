# Caching-Regeln (Apache, mod_headers)
# HTML-Seiten bei jedem Aufruf neu prüfen, damit Änderungen sofort sichtbar sind.
# CSS/JS tragen eine Versionsnummer (?v=…) und dürfen daher lange zwischengespeichert werden.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|gif|svg|ico|pdf)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
